<Project Sdk="Microsoft.NET.Sdk">
  <!-- Rewrites the user's own copy of sts2.dll (output outside the repo) with small, named fixes the
       Android port needs. Never run against the Steam folder in place. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
</Project>
